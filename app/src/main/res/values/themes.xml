<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        应用主题：带 ActionBar，标题栏固定显示「姓名+学号」，各页面用副标题区分。
        实验五继续沿用实验四的 Bridge 主题。实验指导书补充说明：新版 Android Studio 默认的
        Material3 主题会让按钮设置背景后没有变化，需要把主题改成
        Theme.MaterialComponents.DayNight.DarkActionBar.Bridge。
        按钮统一使用下面的 Widget.CardFlipGame.Button 样式：
        background 指定圆角背景 drawable，backgroundTint 指定颜色，保证按钮颜色一定生效。
    -->
    <style name="Theme.CardFlipGame" parent="Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- 统一的圆角按钮样式，实际颜色由各按钮的 android:backgroundTint 指定 -->
    <style name="Widget.CardFlipGame.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 信息行左侧的标签 -->
    <style name="TextAppearance.CardFlipGame.Label" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 信息行右侧的取值 -->
    <style name="TextAppearance.CardFlipGame.Value" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 输入框 -->
    <style name="Widget.CardFlipGame.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edit</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
